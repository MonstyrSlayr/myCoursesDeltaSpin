{
    "manifest_version": 3,
    "name": "MyCourses DeltaSpin",
    "version": "1.0",
    "description": "The world revolves around you. Spin, spin masterfully!",
    "host_permissions":
    [
        "https://mycourses.rit.edu/d2l/*"
    ],
    "web_accessible_resources":
    [
        {
            "resources": ["img/*"],
            "matches": ["<all_urls>"]
        }
    ],
    "permissions":
    [
        "storage"
    ],
    "icons":
    {
        "25": "icons/icon-25.png",
        "50": "icons/icon-50.png",
        "100": "icons/icon-100.png",
        "200": "icons/icon-200.png"
    },
    "content_scripts":
    [
        {
            "matches": ["https://mycourses.rit.edu/d2l/home"],
            "js": ["main.js"],
            "run_at": "document_end"
        }
    ],
    "browser_specific_settings":
    {
        "gecko":
        {
            "id": "mycourses-deltaspin@example.com",
            "strict_min_version": "109.0",
            "data_collection_permissions":
            {
                "required": ["none"]
            }
        }
    }
}
